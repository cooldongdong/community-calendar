---
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import { REPO, getEvents, href, isPast, monthKey } from '../../lib/data';
import { SERIES } from '../../../scripts/facets.mjs';

const all = (await getEvents()).filter((e) => !e.hidden);
const upcoming = all.filter((e) => !isPast(e));
const past = all.filter(isPast).reverse(); // 過去的由近到遠
const groups = (list: typeof all) => [...new Set(list.map(monthKey))].map((m) => [m, list.filter((e) => monthKey(e) === m)] as const);
const monthLabel = (k: string) => (/^\d{4}-\d{2}$/.test(k) ? `${k.slice(0, 4)} 年 ${Number(k.slice(5))} 月` : '日期待確認');

// 篩選選項只列資料裡真的有的
const seriesOpts = SERIES.filter(([slug]) => all.some((e) => e.series === slug)).map(([slug, label]) => [slug, label]);
const cityCount = new Map<string, number>();
for (const e of all) for (const c of e.cities) cityCount.set(c, (cityCount.get(c) ?? 0) + 1);
const cityOpts = [...cityCount].sort((a, b) => b[1] - a[1]).map(([c]) => c);

---
<Base title="活動" description="搜尋 g0v 社群的活動：黑客松、AI Monday、各地小聚與講座，含過去的活動。">
  <div class="title-row">
    <h1 class="page-title">活動</h1>
    <a class="add" href={href('/submit/')}>＋ 新增活動</a>
  </div>

  <section class="list">
    <form class="filters" role="search" onsubmit="return false">
      <div class="search">
        <label for="q" class="sr">搜尋活動</label>
        <input id="q" name="q" type="search" placeholder="搜尋活動名稱、地點、講者…" autocomplete="off" />
      </div>
      <div class="selects">
        <div class="seg" role="radiogroup" aria-label="時間">
          <label><input type="radio" name="when" value="" checked /><span>近期</span></label>
          <label><input type="radio" name="when" value="past" /><span>過去</span></label>
          <label><input type="radio" name="when" value="all" /><span>全部</span></label>
        </div>
        <label class="check"><input type="checkbox" name="jothon" value="1" /><span>只看揪松主辦</span></label>
        <select name="series" aria-label="系列">
          <option value="">所有系列</option>
          {seriesOpts.map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
        <select name="city" aria-label="地點">
          <option value="">所有地點</option>
          <option value="online">線上</option>
          {cityOpts.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="count-row">
        <p class="count muted" aria-live="polite" data-count></p>
        <select class="jump" aria-label="跳到月份" data-jump hidden></select>
      </div>
    </form>

    <div class="body">
    <div class="lists">
    <div data-list="upcoming">
      {groups(upcoming).map(([m, list]) => (
        <section data-month={m} id={`upcoming-${m}`}>
          <h3 class="month-title">{monthLabel(m)}</h3>
          {list.map((e) => <EventRow event={e} />)}
        </section>
      ))}
    </div>
    <div data-list="past">
      <h2 class="past-title" data-past-title>過去的活動</h2>
      {groups(past).map(([m, list]) => (
        <section data-month={m} id={`past-${m}`}>
          <h3 class="month-title">{monthLabel(m)}</h3>
          {list.map((e) => <EventRow event={e} />)}
        </section>
      ))}
    </div>
    <p class="empty muted" data-empty hidden>沒有符合條件的活動。</p>
    </div>
    <nav class="timeline" aria-label="時間軸" data-timeline></nav>
    </div>
  </section>

  <!-- 管理模式（網址加 ?admin=1）：勾選多場活動一次改系列、揪松主辦或拿掉。
       這不是權限控管，只是不讓一般訪客看到勾選框；真正的門檻在 issue 轉 PR 時檢查送出的人是不是 repo 協作者 -->
  <div class="admin-bar" data-admin-bar data-repo={REPO} hidden>
    <span class="sel"><strong data-sel-count>0</strong> 場已選</span>
    <button type="button" class="btn" data-sel-visible>全選目前顯示的</button>
    <button type="button" class="btn" data-sel-clear>清除</button>
    <button type="button" class="btn primary" data-batch-open>批次修改…</button>
    <span class="msg" data-bar-msg aria-live="polite"></span>
    <button type="button" class="btn link" data-admin-exit>離開管理模式</button>
  </div>
  <dialog class="batch" data-batch>
    <form data-batch-form>
      <h2>批次修改 <span data-batch-n></span> 場</h2>
      <p class="muted small">只能改這三項，沒有要改的保持「不改」。地點、時間這些共筆上有的內容請改共筆。送出後只有 repo 協作者的 issue 會自動開 PR。</p>
      <label class="field">
        <span class="l">系列</span>
        <select name="series">
          <option value="">不改</option>
          {SERIES.map(([slug, label]) => <option value={slug}>{label}</option>)}
          <option value="none">不屬於任何系列</option>
        </select>
      </label>
      <fieldset class="field">
        <legend class="l">揪松主辦</legend>
        <label><input type="radio" name="jothon" value="" checked /> 不改</label>
        <label><input type="radio" name="jothon" value="是" /> 是</label>
        <label><input type="radio" name="jothon" value="不是" /> 不是</label>
      </fieldset>
      <label class="check"><input type="checkbox" name="takedown" /> 全部從行事曆上拿掉</label>
      <label class="field">
        <span class="l">為什麼要改</span>
        <textarea name="reason" rows="3" required></textarea>
      </label>
      <p class="err" data-batch-err hidden></p>
      <div class="actions">
        <button type="button" class="btn" data-batch-cancel>取消</button>
        <button type="submit" class="btn primary">到 GitHub 送出</button>
      </div>
    </form>
  </dialog>

</Base>

<script>
  // 篩選全在瀏覽器端做：每一列都帶著自己的 data-*，條件寫進網址，可以直接分享
  const form = document.querySelector<HTMLFormElement>('.filters')!;
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  const lists = { upcoming: document.querySelector<HTMLElement>('[data-list="upcoming"]')!, past: document.querySelector<HTMLElement>('[data-list="past"]')! };
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const pastTitle = document.querySelector<HTMLElement>('[data-past-title]')!;

  // 網址 → 表單
  const params = new URLSearchParams(location.search);
  for (const [k, v] of params) {
    const el = form.elements.namedItem(k);
    if (el instanceof RadioNodeList) el.value = v;
    else if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = v === '1';
    else if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) el.value = v;
  }

  function apply() {
    const data = new FormData(form);
    const q = String(data.get('q') ?? '').trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    const when = String(data.get('when') ?? '');
    const jothon = data.get('jothon') === '1';
    const series = String(data.get('series') ?? '');
    const city = String(data.get('city') ?? '');
    // 有搜尋字時，「近期」也一起搜過去的——找不到過去的活動是最常見的落空
    const showPast = when === 'past' || when === 'all' || (terms.length > 0 && when === '');
    const showUpcoming = when !== 'past';

    let n = 0;
    for (const r of rows) {
      const ok = (r.dataset.when === 'past' ? showPast : showUpcoming)
        && (!jothon || r.dataset.jothon === '1')
        && (!series || r.dataset.series === series)
        && (!city || (city === 'online' ? r.dataset.online === '1' : r.dataset.cities!.split(' ').includes(city)))
        && terms.every((t) => r.dataset.text!.includes(t));
      r.hidden = !ok;
      if (ok) n++;
    }
    document.querySelectorAll<HTMLElement>('[data-month]').forEach((m) => (m.hidden = !m.querySelector('[data-row]:not([hidden])')));
    lists.upcoming.hidden = !showUpcoming;
    lists.past.hidden = !showPast || !lists.past.querySelector('[data-row]:not([hidden])');
    pastTitle.hidden = !showUpcoming; // 只看過去的時候不需要這個分隔標題
    empty.hidden = n > 0;
    count.textContent = q || jothon || series || city || when ? `${n} 場活動` : '';

    // 表單 → 網址（預設值不寫，網址保持乾淨）
    const out = new URLSearchParams();
    if (q) out.set('q', q);
    if (when) out.set('when', when);
    if (jothon) out.set('jothon', '1');
    if (series) out.set('series', series);
    if (city) out.set('city', city);
    history.replaceState(null, '', out.size ? `?${out}` : location.pathname);
    buildTimeline();
  }

  // 時間軸：依目前看得到的月份產生。寬螢幕是右邊一條，窄螢幕是「跳到月份」選單
  const timeline = document.querySelector<HTMLElement>('[data-timeline]')!;
  const jump = document.querySelector<HTMLSelectElement>('[data-jump]')!;
  const monthName = (k: string) => (/^\d{4}-\d{2}$/.test(k) ? `${Number(k.slice(5))} 月` : '未定');
  let spy: IntersectionObserver | undefined;
  function buildTimeline() {
    const sections = [...document.querySelectorAll<HTMLElement>('[data-month]')].filter((m) => !m.hidden && !m.closest('[data-list]')!.hidden);
    const both = new Set(sections.map((m) => m.closest<HTMLElement>('[data-list]')!.dataset.list)).size > 1;
    let html = '', opts = '', lastGroup = '', lastYear = '';
    for (const m of sections) {
      const list = m.closest<HTMLElement>('[data-list]')!.dataset.list!;
      const key = m.dataset.month!;
      const year = key.slice(0, 4);
      if (both && list !== lastGroup) { html += `<p class="tl-group">${list === 'past' ? '過去' : '近期'}</p>`; lastGroup = list; lastYear = ''; }
      if (year !== lastYear) { html += `<p class="tl-year">${/^\d{4}$/.test(year) ? year : ''}</p>`; lastYear = year; }
      html += `<a href="#${m.id}" data-for="${m.id}">${monthName(key)}</a>`;
      opts += `<option value="${m.id}">${both ? (list === 'past' ? '過去・' : '近期・') : ''}${/^\d{4}/.test(key) ? `${year} 年 ` : ''}${monthName(key)}</option>`;
    }
    timeline.innerHTML = html;
    jump.innerHTML = `<option value="">跳到月份…</option>${opts}`;
    jump.hidden = sections.length < 2;
    // 捲動時標出現在看到的月份
    spy?.disconnect();
    spy = new IntersectionObserver((entries) => {
      for (const en of entries) if (en.isIntersecting) {
        timeline.querySelectorAll('a').forEach((a) => a.classList.toggle('on', a.dataset.for === en.target.id));
        timeline.querySelector('a.on')?.scrollIntoView({ block: 'nearest' });
      }
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((m) => spy!.observe(m));
  }
  jump.addEventListener('change', () => {
    if (jump.value) document.getElementById(jump.value)?.scrollIntoView({ behavior: 'smooth' });
    jump.value = '';
  });
  form.addEventListener('input', (ev) => { if (ev.target !== jump) apply(); });
  form.addEventListener('change', (ev) => { if (ev.target !== jump) apply(); });
  apply();

  // ---------- 管理模式：批次修改 ----------
  // ?admin=1 打開、?admin=0 關掉，會記在這台瀏覽器
  const ADMIN_KEY = 'cc-admin';
  const store = (v?: boolean) => {
    try {
      if (v === undefined) return localStorage.getItem(ADMIN_KEY) === '1';
      v ? localStorage.setItem(ADMIN_KEY, '1') : localStorage.removeItem(ADMIN_KEY);
    } catch {}
    return !!v;
  };
  const adminParam = params.get('admin');
  const admin = adminParam === '1' ? store(true) : adminParam === '0' ? store(false) : store();
  if (admin) setupAdmin();

  function setupAdmin() {
    const bar = document.querySelector<HTMLElement>('[data-admin-bar]')!;
    const dialog = document.querySelector<HTMLDialogElement>('[data-batch]')!;
    const bform = document.querySelector<HTMLFormElement>('[data-batch-form]')!;
    const err = document.querySelector<HTMLElement>('[data-batch-err]')!;
    const selCount = document.querySelector<HTMLElement>('[data-sel-count]')!;
    const picked = new Set<string>();
    const titles = new Map<string, string>();
    bar.hidden = false;
    document.body.classList.add('admin');

    for (const r of rows) {
      const id = r.dataset.id!;
      titles.set(id, r.querySelector('h3')?.textContent?.trim() ?? id);
      const box = document.createElement('label');
      box.className = 'pick';
      box.innerHTML = '<input type="checkbox" />';
      box.title = '選這場';
      const input = box.querySelector('input')!;
      input.dataset.pick = id;
      input.setAttribute('aria-label', `選擇：${titles.get(id)}`);
      r.querySelector('.meta')!.prepend(box);
    }
    const sync = () => {
      document.querySelectorAll<HTMLInputElement>('[data-pick]').forEach((i) => (i.checked = picked.has(i.dataset.pick!)));
      selCount.textContent = String(picked.size);
    };
    document.addEventListener('change', (ev) => {
      const t = ev.target as HTMLInputElement;
      if (!t.dataset?.pick) return;
      t.checked ? picked.add(t.dataset.pick) : picked.delete(t.dataset.pick);
      sync();
    });
    // 「目前顯示的」＝篩選後看得到的：列本身、所在月份、所在清單都沒被藏起來
    const visible = () => rows.filter((r) => !r.hidden && !r.closest<HTMLElement>('[data-month]')!.hidden && !r.closest<HTMLElement>('[data-list]')!.hidden);
    bar.querySelector('[data-sel-visible]')!.addEventListener('click', () => { visible().forEach((r) => picked.add(r.dataset.id!)); sync(); });
    bar.querySelector('[data-sel-clear]')!.addEventListener('click', () => { picked.clear(); sync(); });
    bar.querySelector('[data-admin-exit]')!.addEventListener('click', () => { store(false); location.reload(); });
    bar.querySelector('[data-batch-open]')!.addEventListener('click', () => {
      if (!picked.size) { flash('還沒有勾選任何活動'); return; }
      document.querySelector('[data-batch-n]')!.textContent = String(picked.size);
      err.hidden = true;
      dialog.showModal();
    });
    dialog.querySelector('[data-batch-cancel]')!.addEventListener('click', () => dialog.close());

    const msg = bar.querySelector<HTMLElement>('[data-bar-msg]')!;
    let msgTimer: number | undefined;
    function flash(text: string) {
      msg.textContent = text;
      clearTimeout(msgTimer);
      msgTimer = window.setTimeout(() => (msg.textContent = ''), 2500);
    }

    // GitHub 預填網址太長會失敗（約 8 KB），超過就請他分批。場數上限跟 scripts/issue-to-pr.mjs 的 MAX_BATCH 一致
    const MAX_URL = 8000, MAX_IDS = 300;
    bform.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const d = new FormData(bform);
      const series = String(d.get('series') ?? '');
      const jothon = String(d.get('jothon') ?? '');
      const takedown = d.get('takedown') === 'on';
      const reason = String(d.get('reason') ?? '').trim();
      const ids = [...picked].sort();
      const problem = !series && !jothon && !takedown ? '系列、揪松主辦、拿掉至少要改一項。' : !reason ? '請寫一下為什麼要改。' : null;
      err.hidden = !problem; err.textContent = problem ?? '';
      if (problem) return;

      const what = [
        series && `系列→${bform.querySelector<HTMLSelectElement>('[name=series]')!.selectedOptions[0].textContent}`,
        jothon && `揪松主辦→${jothon}`,
        takedown && '拿掉',
      ].filter(Boolean).join('、');
      const q = new URLSearchParams({ template: 'batch-edit.yml', title: `批次修改：${what}（${ids.length} 場）`, event_ids: ids.join('\n') });
      if (series) q.set('series', series);
      if (jothon) q.set('jothon', jothon);
      if (takedown) q.set('takedown', '請拿掉');
      q.set('reason', reason);
      const url = `${bar.dataset.repo}/issues/new?${q}`;
      if (url.length > MAX_URL || ids.length > MAX_IDS) {
        const idsLen = new URLSearchParams({ x: ids.join('\n') }).toString().length - 2;
        const fit = Math.min(MAX_IDS, Math.floor((MAX_URL - (url.length - idsLen)) / (idsLen / ids.length)));
        err.hidden = false;
        err.textContent = `一次選太多了（${ids.length} 場），請分批送，一批 ${fit} 場以內。`;
        return;
      }
      window.open(url, '_blank', 'noopener');
      dialog.close();
    });
    sync();
  }

</script>

<style>
  .title-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
  .add { font-size: .9rem; text-decoration: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .filters { position: sticky; top: 64px; z-index: 3; margin: 28px 0 8px; padding: 12px 0; background: var(--bg); display: grid; gap: 10px; }
  .search input {
    width: 100%; height: 44px; padding: 0 14px; border-radius: var(--r-md); border: 1px solid var(--line);
    background: var(--surface); color: var(--text); font: inherit;
  }
  .search input:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: transparent; }
  .selects { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .seg { display: inline-flex; padding: 3px; border-radius: var(--r-md); background: var(--surface-2); }
  .seg label { cursor: pointer; }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg span { display: inline-block; padding: 4px 12px; border-radius: var(--r-sm); font-size: .875rem; color: var(--muted); }
  .seg input:checked + span { background: var(--surface); color: var(--text); box-shadow: var(--shadow); }
  .seg input:focus-visible + span { outline: 2px solid var(--accent); }
  .check { display: inline-flex; align-items: center; gap: 6px; font-size: .875rem; cursor: pointer; }
  select {
    height: 34px; padding: 0 10px; border-radius: var(--r-md); border: 1px solid var(--line);
    background: var(--surface); color: var(--text); font: inherit; font-size: .875rem; max-width: 100%;
  }
  .count-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 34px; }
  .count { margin: 0; font-size: .85rem; }
  .jump { margin-left: auto; }

  .body { display: grid; gap: 32px; }
  .timeline { display: none; }
  @media (min-width: 1024px) {
    .body { grid-template-columns: minmax(0, 1fr) 120px; }
    .jump { display: none; }
    .timeline {
      display: flex; flex-direction: column; position: sticky; top: 210px; align-self: start;
      max-height: calc(100vh - 230px); overflow-y: auto; padding: 4px 0 4px 16px; border-left: 1px solid var(--line);
      font-size: .85rem; scrollbar-width: thin;
    }
  }
  .timeline :global(.tl-group) { margin: 8px 0 2px; font-size: .75rem; font-weight: 600; color: var(--accent); }
  .timeline :global(.tl-year) { margin: 10px 0 2px; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
  .timeline :global(a) { padding: 2px 0; color: var(--muted); text-decoration: none; }
  .timeline :global(a:hover) { color: var(--text); }
  .timeline :global(a.on) { color: var(--accent); font-weight: 600; }
  [data-month] { scroll-margin-top: 220px; }

  .month-title { margin: 28px 0 0; font-size: .95rem; color: var(--muted); font-weight: 600; }
  .past-title { margin: 56px 0 0; font-size: 1.1rem; }
  .empty { padding: 40px 0; text-align: center; }

  /* 管理模式 */
  :global(body.admin) { padding-bottom: 96px; }
  :global(.pick) { display: inline-flex; align-items: center; cursor: pointer; }
  :global(.pick input) { width: 18px; height: 18px; accent-color: var(--accent); cursor: pointer; }
  .admin-bar {
    position: fixed; left: 50%; bottom: 16px; transform: translateX(-50%); z-index: 10;
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px; width: max-content; max-width: calc(100vw - 32px);
    padding: 10px 14px; border-radius: var(--r-md); border: 1px solid var(--line);
    background: var(--surface); box-shadow: var(--shadow); font-size: .875rem;
  }
  .admin-bar[hidden] { display: none; }
  .sel { margin-right: 4px; }
  .msg { color: var(--warn); }
  .msg:empty { display: none; }
  .btn {
    display: inline-flex; align-items: center; min-height: 34px; padding: 0 12px; border-radius: var(--r-md);
    border: 1px solid var(--line); background: transparent; color: var(--text); font: inherit; font-size: .85rem; cursor: pointer;
  }
  .btn:hover { border-color: var(--muted); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.link { border-color: transparent; color: var(--muted); }

  .batch {
    width: min(480px, calc(100vw - 32px)); padding: 24px; border-radius: var(--r-md); border: 1px solid var(--line);
    background: var(--bg); color: var(--text);
  }
  .batch::backdrop { background: rgb(0 0 0 / .4); }
  .batch h2 { margin: 0 0 8px; font-size: 1.15rem; }
  .batch form { display: grid; gap: 14px; }
  .batch .small { margin: 0; font-size: .85rem; }
  .batch .field { display: flex; flex-direction: column; gap: 6px; border: 0; padding: 0; margin: 0; }
  .batch fieldset.field { flex-direction: row; flex-wrap: wrap; gap: 6px 16px; }
  .batch fieldset legend { width: 100%; margin-bottom: 6px; }
  .batch .l { font-size: .875rem; font-weight: 600; }
  .batch select, .batch textarea {
    width: 100%; padding: 9px 12px; border-radius: var(--r-md); border: 1px solid var(--line);
    background: var(--surface); color: var(--text); font: inherit; font-size: .95rem; height: auto;
  }
  .batch .check { font-size: .9rem; }
  .batch .err { margin: 0; color: var(--warn); }
  .batch .actions { display: flex; justify-content: flex-end; gap: 8px; }

</style>
