---
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import { REPO, getEvents, href, isPast, monthKey, vanishedEarly } from '../../lib/data';
import { SERIES } from '../../../scripts/facets.mjs';

const all = (await getEvents()).filter((e) => !e.hidden);
const upcoming = all.filter((e) => !isPast(e));
const past = all.filter(isPast).reverse(); // 過去的由近到遠
const groups = (list: typeof all) => [...new Set(list.map(monthKey))].map((m) => [m, list.filter((e) => monthKey(e) === m)] as const);
const monthLabel = (k: string) => (/^\d{4}-\d{2}$/.test(k) ? `${k.slice(0, 4)} 年 ${Number(k.slice(5))} 月` : '日期待確認');

// 篩選選項只列資料裡真的有的
const seriesOpts = SERIES.filter(([slug]) => all.some((e) => e.series === slug)).map(([slug, label]) => [slug, label]);
const cityCount = new Map<string, number>();
for (const e of all) for (const c of e.cities) cityCount.set(c, (cityCount.get(c) ?? 0) + 1);
const cityOpts = [...cityCount].sort((a, b) => b[1] - a[1]).map(([c]) => c);

// 共筆已移除的活動：同一天共筆上還在的有哪些。管理模式拿來判斷是取消、誤刪，還是改名重貼
const sameDay = new Map(all.filter(vanishedEarly).map((e) => [e.id, all.filter((o) => o.id !== e.id && o.in_source && o.date_start === e.date_start).map((o) => o.title)]));

---
<Base title="活動" description="搜尋 g0v 社群的活動：黑客松、AI Monday、各地小聚與講座，含過去的活動。">
  <div class="title-row">
    <h1 class="page-title">活動</h1>
    <span class="admin-tag" data-admin-only hidden>管理模式・<button type="button" class="linkish" data-admin-exit>離開</button></span>
    <a class="add" href={href('/submit/')}>＋ 新增活動</a>
  </div>

  <section class="list">
    <form class="filters" role="search" onsubmit="return false">
      <div class="search">
        <label for="q" class="sr">搜尋活動</label>
        <input id="q" name="q" type="search" placeholder="搜尋活動名稱、地點、講者…" autocomplete="off" />
      </div>
      <div class="selects">
        <div class="seg" role="radiogroup" aria-label="時間">
          <label><input type="radio" name="when" value="" checked /><span>近期</span></label>
          <label><input type="radio" name="when" value="past" /><span>過去</span></label>
          <label><input type="radio" name="when" value="all" /><span>全部</span></label>
        </div>
        <label class="check"><input type="checkbox" name="jothon" value="1" /><span>只看揪松主辦</span></label>
        <label class="check" data-admin-only hidden><input type="checkbox" name="vanished" value="1" /><span>只看共筆已移除</span></label>
        <select name="series" aria-label="系列">
          <option value="">所有系列</option>
          {seriesOpts.map(([v, l]) => <option value={v}>{l}</option>)}
        </select>
        <select name="city" aria-label="地點">
          <option value="">所有地點</option>
          <option value="online">線上</option>
          {cityOpts.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="count-row">
        <label class="sel-all" data-admin-only hidden><input type="checkbox" data-sel-all /><span data-sel-all-label></span></label>
        <p class="count muted" aria-live="polite" data-count></p>
        <select class="jump" aria-label="跳到月份" data-jump hidden></select>
      </div>
    </form>

    <div class="body">
    <div class="lists">
    <div data-list="upcoming">
      {groups(upcoming).map(([m, list]) => (
        <section data-month={m} id={`upcoming-${m}`}>
          <h3 class="month-title">{monthLabel(m)}</h3>
          {list.map((e) => <EventRow event={e} sameDay={sameDay.get(e.id)} />)}
        </section>
      ))}
    </div>
    <div data-list="past">
      <h2 class="past-title" data-past-title>過去的活動</h2>
      {groups(past).map(([m, list]) => (
        <section data-month={m} id={`past-${m}`}>
          <h3 class="month-title">{monthLabel(m)}</h3>
          {list.map((e) => <EventRow event={e} sameDay={sameDay.get(e.id)} />)}
        </section>
      ))}
    </div>
    <p class="empty muted" data-empty hidden>沒有符合條件的活動。</p>
    </div>
    <nav class="timeline" aria-label="時間軸" data-timeline></nav>
    </div>
  </section>

  <!-- 管理模式（網址加 ?admin=1）：點活動選取（Shift＋點選一段），在底部的工具列選要改成什麼，一次送出。
       這不是權限控管，只是不讓一般訪客看到這些；真正的門檻在 issue 轉 PR 時檢查送出的人是不是 repo 協作者 -->
  <div class="admin-bar" data-admin-bar data-repo={REPO} hidden>
    <div class="bar-sel">
      <button type="button" class="icon" data-sel-clear aria-label="全部取消選取" title="全部取消選取（Esc）" hidden>✕</button>
      <span data-sel-text aria-live="polite"></span>
    </div>
    <div class="bar-actions">
      <label class="chip">
        <span class="k">系列</span>
        <select data-act="series" aria-label="系列改成">
          <option value="">不改</option>
          {SERIES.map(([slug, label]) => <option value={slug}>{label}</option>)}
          <option value="none">不屬於任何系列</option>
        </select>
      </label>
      <label class="chip">
        <span class="k">揪松主辦</span>
        <select data-act="jothon" aria-label="揪松主辦改成">
          <option value="">不改</option>
          <option value="是">是</option>
          <option value="不是">不是</option>
        </select>
      </label>
      <button type="button" class="chip takedown" data-takedown aria-pressed="false">拿掉</button>
      <button type="button" class="btn primary" data-batch-open disabled>送出…</button>
    </div>
    <span class="msg" data-bar-msg aria-live="polite"></span>
  </div>
  <dialog class="batch" data-batch>
    <form data-batch-form>
      <h2 data-batch-summary></h2>
      <p class="takedown-note" data-batch-takedown hidden>合併後這些活動會從網站與所有訂閱日曆消失（資料仍保留，之後可以恢復）。</p>
      <details class="picked-list">
        <summary>看選了哪些</summary>
        <ul data-batch-list></ul>
      </details>
      <label class="field">
        <span class="l">為什麼要改</span>
        <textarea name="reason" rows="3" required placeholder="例如：共筆已移除，確認是取消了"></textarea>
      </label>
      <p class="muted small">會打開一張填好的 GitHub issue，按 Submit 後自動開 PR，管理員合併才生效。只有 repo 協作者送的會開 PR。</p>
      <p class="err" data-batch-err hidden></p>
      <div class="actions">
        <button type="button" class="btn" data-batch-cancel>取消</button>
        <button type="submit" class="btn primary">到 GitHub 送出</button>
      </div>
    </form>
  </dialog>

</Base>

<script>
  // 篩選全在瀏覽器端做：每一列都帶著自己的 data-*，條件寫進網址，可以直接分享
  const form = document.querySelector<HTMLFormElement>('.filters')!;
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  const lists = { upcoming: document.querySelector<HTMLElement>('[data-list="upcoming"]')!, past: document.querySelector<HTMLElement>('[data-list="past"]')! };
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const pastTitle = document.querySelector<HTMLElement>('[data-past-title]')!;

  // 網址 → 表單
  const params = new URLSearchParams(location.search);
  for (const [k, v] of params) {
    const el = form.elements.namedItem(k);
    if (el instanceof RadioNodeList) el.value = v;
    else if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = v === '1';
    else if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) el.value = v;
  }

  // 管理模式：?admin=1 打開、?admin=0 關掉，會記在這台瀏覽器
  const ADMIN_KEY = 'cc-admin';
  const store = (v?: boolean) => {
    try {
      if (v === undefined) return localStorage.getItem(ADMIN_KEY) === '1';
      v ? localStorage.setItem(ADMIN_KEY, '1') : localStorage.removeItem(ADMIN_KEY);
    } catch {}
    return !!v;
  };
  const adminParam = params.get('admin');
  const admin = adminParam === '1' ? store(true) : adminParam === '0' ? store(false) : store();
  let afterApply = () => {};

  function apply() {
    const data = new FormData(form);
    const q = String(data.get('q') ?? '').trim().toLowerCase();
    const terms = q.split(/\s+/).filter(Boolean);
    const when = String(data.get('when') ?? '');
    const jothon = data.get('jothon') === '1';
    const series = String(data.get('series') ?? '');
    const city = String(data.get('city') ?? '');
    const vanished = admin && data.get('vanished') === '1';
    // 有搜尋字時，「近期」也一起搜過去的——找不到過去的活動是最常見的落空。「共筆已移除」也是，多半是過去的
    const showPast = when === 'past' || when === 'all' || ((terms.length > 0 || vanished) && when === '');
    const showUpcoming = when !== 'past';

    let n = 0;
    for (const r of rows) {
      const ok = (r.dataset.when === 'past' ? showPast : showUpcoming)
        && (!jothon || r.dataset.jothon === '1')
        && (!series || r.dataset.series === series)
        && (!city || (city === 'online' ? r.dataset.online === '1' : r.dataset.cities!.split(' ').includes(city)))
        && (!vanished || r.dataset.vanished === '1')
        && terms.every((t) => r.dataset.text!.includes(t));
      r.hidden = !ok;
      if (ok) n++;
    }
    document.querySelectorAll<HTMLElement>('[data-month]').forEach((m) => (m.hidden = !m.querySelector('[data-row]:not([hidden])')));
    lists.upcoming.hidden = !showUpcoming;
    lists.past.hidden = !showPast || !lists.past.querySelector('[data-row]:not([hidden])');
    pastTitle.hidden = !showUpcoming || !lists.upcoming.querySelector('[data-row]:not([hidden])'); // 上面沒有近期的活動時，不需要這個分隔標題
    empty.hidden = n > 0;
    count.textContent = q || jothon || series || city || when || vanished ? `${n} 場活動` : '';

    // 表單 → 網址（預設值不寫，網址保持乾淨）
    const out = new URLSearchParams();
    if (q) out.set('q', q);
    if (when) out.set('when', when);
    if (jothon) out.set('jothon', '1');
    if (series) out.set('series', series);
    if (city) out.set('city', city);
    if (vanished) out.set('vanished', '1');
    history.replaceState(null, '', out.size ? `?${out}` : location.pathname);
    buildTimeline();
    afterApply();
  }

  // 時間軸：依目前看得到的月份產生。寬螢幕是右邊一條，窄螢幕是「跳到月份」選單
  const timeline = document.querySelector<HTMLElement>('[data-timeline]')!;
  const jump = document.querySelector<HTMLSelectElement>('[data-jump]')!;
  const monthName = (k: string) => (/^\d{4}-\d{2}$/.test(k) ? `${Number(k.slice(5))} 月` : '未定');
  let spy: IntersectionObserver | undefined;
  function buildTimeline() {
    const sections = [...document.querySelectorAll<HTMLElement>('[data-month]')].filter((m) => !m.hidden && !m.closest('[data-list]')!.hidden);
    const both = new Set(sections.map((m) => m.closest<HTMLElement>('[data-list]')!.dataset.list)).size > 1;
    let html = '', opts = '', lastGroup = '', lastYear = '';
    for (const m of sections) {
      const list = m.closest<HTMLElement>('[data-list]')!.dataset.list!;
      const key = m.dataset.month!;
      const year = key.slice(0, 4);
      if (both && list !== lastGroup) { html += `<p class="tl-group">${list === 'past' ? '過去' : '近期'}</p>`; lastGroup = list; lastYear = ''; }
      if (year !== lastYear) { html += `<p class="tl-year">${/^\d{4}$/.test(year) ? year : ''}</p>`; lastYear = year; }
      html += `<a href="#${m.id}" data-for="${m.id}">${monthName(key)}</a>`;
      opts += `<option value="${m.id}">${both ? (list === 'past' ? '過去・' : '近期・') : ''}${/^\d{4}/.test(key) ? `${year} 年 ` : ''}${monthName(key)}</option>`;
    }
    timeline.innerHTML = html;
    jump.innerHTML = `<option value="">跳到月份…</option>${opts}`;
    jump.hidden = sections.length < 2;
    // 捲動時標出現在看到的月份
    spy?.disconnect();
    spy = new IntersectionObserver((entries) => {
      for (const en of entries) if (en.isIntersecting) {
        timeline.querySelectorAll('a').forEach((a) => a.classList.toggle('on', a.dataset.for === en.target.id));
        timeline.querySelector('a.on')?.scrollIntoView({ block: 'nearest' });
      }
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((m) => spy!.observe(m));
  }
  jump.addEventListener('change', () => {
    if (jump.value) document.getElementById(jump.value)?.scrollIntoView({ behavior: 'smooth' });
    jump.value = '';
  });
  form.addEventListener('input', (ev) => { if (ev.target !== jump) apply(); });
  form.addEventListener('change', (ev) => { if (ev.target !== jump) apply(); });
  apply();

  if (admin) setupAdmin();

  // ---------- 管理模式：批次修改 ----------
  // 點活動選取、Shift＋點選一段、Esc 全部取消；在底部工具列選要改成什麼，確認後開一張填好的 GitHub issue
  function setupAdmin() {
    const bar = document.querySelector<HTMLElement>('[data-admin-bar]')!;
    const dialog = document.querySelector<HTMLDialogElement>('[data-batch]')!;
    const bform = document.querySelector<HTMLFormElement>('[data-batch-form]')!;
    const err = document.querySelector<HTMLElement>('[data-batch-err]')!;
    const selText = bar.querySelector<HTMLElement>('[data-sel-text]')!;
    const clearBtn = bar.querySelector<HTMLButtonElement>('[data-sel-clear]')!;
    const sendBtn = bar.querySelector<HTMLButtonElement>('[data-batch-open]')!;
    const seriesSel = bar.querySelector<HTMLSelectElement>('[data-act="series"]')!;
    const jothonSel = bar.querySelector<HTMLSelectElement>('[data-act="jothon"]')!;
    const takedownBtn = bar.querySelector<HTMLButtonElement>('[data-takedown]')!;
    const selAll = document.querySelector<HTMLInputElement>('[data-sel-all]')!;
    const selAllLabel = document.querySelector<HTMLElement>('[data-sel-all-label]')!;
    const picked = new Set<string>();
    const byId = new Map(rows.map((r) => [r.dataset.id!, r]));
    const titleOf = (id: string) => byId.get(id)?.querySelector('h3')?.textContent?.trim() ?? id;
    bar.hidden = false;
    document.querySelectorAll<HTMLElement>('[data-admin-only]').forEach((el) => (el.hidden = false));
    document.body.classList.add('admin');

    // 每列前面一個勾勾。用 role=checkbox 的 span，點擊統一由列處理
    for (const r of rows) {
      const box = document.createElement('span');
      box.className = 'pick';
      box.setAttribute('role', 'checkbox');
      box.setAttribute('aria-checked', 'false');
      box.setAttribute('aria-label', `選擇：${titleOf(r.dataset.id!)}`);
      box.tabIndex = 0;
      r.prepend(box);
    }

    // 「目前顯示的」＝篩選後看得到的：列本身、所在月份、所在清單都沒被藏起來
    const visible = () => rows.filter((r) => !r.hidden && !r.closest<HTMLElement>('[data-month]')!.hidden && !r.closest<HTMLElement>('[data-list]')!.hidden);
    const takedown = () => takedownBtn.getAttribute('aria-pressed') === 'true';
    const hasAction = () => !!seriesSel.value || !!jothonSel.value || takedown();

    function sync() {
      for (const r of rows) {
        const on = picked.has(r.dataset.id!);
        r.classList.toggle('picked', on);
        r.querySelector('.pick')!.setAttribute('aria-checked', String(on));
      }
      const vis = visible();
      const k = vis.filter((r) => picked.has(r.dataset.id!)).length;
      const off = picked.size - k;
      selText.textContent = `已選 ${picked.size} 場${off ? `（${off} 場不在目前的篩選裡）` : ''}`;
      clearBtn.hidden = !picked.size;
      selAll.checked = vis.length > 0 && k === vis.length;
      selAll.indeterminate = k > 0 && k < vis.length;
      selAll.disabled = !vis.length;
      selAllLabel.textContent = k ? `已選 ${k}／${vis.length}` : `全選目前顯示的 ${vis.length} 場`;
      for (const sel of [seriesSel, jothonSel]) sel.closest('.chip')!.classList.toggle('on', !!sel.value);
      sendBtn.disabled = !picked.size || !hasAction();
      sendBtn.title = !picked.size ? '先選活動' : !hasAction() ? '先選要改成什麼' : '';
    }
    afterApply = sync;

    const set = (id: string, on: boolean) => (on ? picked.add(id) : picked.delete(id));
    let anchor: string | null = null;
    function toggle(r: HTMLElement, range: boolean) {
      const id = r.dataset.id!;
      const on = !picked.has(id);
      const vis = visible();
      const i = anchor ? vis.findIndex((x) => x.dataset.id === anchor) : -1;
      if (range && i >= 0) {
        const j = vis.indexOf(r);
        for (const x of vis.slice(Math.min(i, j), Math.max(i, j) + 1)) set(x.dataset.id!, on);
      } else set(id, on);
      anchor = id;
      sync();
    }

    const listsWrap = document.querySelector<HTMLElement>('.lists')!;
    // Shift＋點的時候不要順便反白一段文字
    listsWrap.addEventListener('mousedown', (ev) => { if (ev.shiftKey && (ev.target as Element).closest('[data-row]')) ev.preventDefault(); });
    listsWrap.addEventListener('click', (ev) => {
      const r = (ev.target as Element).closest<HTMLElement>('[data-row]');
      if (!r) return;
      const link = (ev.target as Element).closest('a');
      // 連結：還沒開始選的時候照常打開；開始選了之後點到哪都算選取。Cmd／Ctrl＋點永遠是開新分頁
      if (link && (ev.metaKey || ev.ctrlKey || (!picked.size && !(ev.target as Element).closest('.pick')))) return;
      ev.preventDefault();
      toggle(r, ev.shiftKey);
    });
    listsWrap.addEventListener('keydown', (ev) => {
      const box = (ev.target as Element).closest('.pick');
      if (!box || (ev.key !== ' ' && ev.key !== 'Enter')) return;
      ev.preventDefault();
      toggle(box.closest<HTMLElement>('[data-row]')!, ev.shiftKey);
    });
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && !dialog.open && picked.size) { picked.clear(); anchor = null; sync(); }
    });

    // 勾勾本身的狀態不算數，一律從 picked 重畫
    selAll.addEventListener('change', () => {
      const vis = visible();
      const all = vis.every((r) => picked.has(r.dataset.id!));
      vis.forEach((r) => set(r.dataset.id!, !all));
      sync();
    });
    clearBtn.addEventListener('click', () => { picked.clear(); anchor = null; sync(); });
    seriesSel.addEventListener('change', sync);
    jothonSel.addEventListener('change', sync);
    takedownBtn.addEventListener('click', () => { takedownBtn.setAttribute('aria-pressed', String(!takedown())); sync(); });
    document.querySelectorAll('[data-admin-exit]').forEach((b) => b.addEventListener('click', () => { store(false); location.reload(); }));

    const msg = bar.querySelector<HTMLElement>('[data-bar-msg]')!;
    let msgTimer: number | undefined;
    function flash(text: string) {
      msg.textContent = text;
      clearTimeout(msgTimer);
      msgTimer = window.setTimeout(() => (msg.textContent = ''), 4000);
    }

    const whatText = () => [
      seriesSel.value && `系列→${seriesSel.selectedOptions[0].textContent}`,
      jothonSel.value && `揪松主辦→${jothonSel.value}`,
      takedown() && '拿掉',
    ].filter(Boolean).join('、');

    sendBtn.addEventListener('click', () => {
      const ids = [...picked].sort();
      document.querySelector('[data-batch-summary]')!.textContent = `${ids.length} 場：${whatText()}`;
      document.querySelector<HTMLElement>('[data-batch-takedown]')!.hidden = !takedown();
      const list = document.querySelector<HTMLElement>('[data-batch-list]')!;
      list.replaceChildren(...ids.map((id) => Object.assign(document.createElement('li'), { textContent: `${id.slice(0, 10)}　${titleOf(id)}` })));
      err.hidden = true;
      dialog.showModal();
    });
    dialog.querySelector('[data-batch-cancel]')!.addEventListener('click', () => dialog.close());

    // GitHub 預填網址太長會失敗（約 8 KB），超過就請他分批。場數上限跟 scripts/issue-to-pr.mjs 的 MAX_BATCH 一致
    const MAX_URL = 8000, MAX_IDS = 300;
    bform.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const reason = String(new FormData(bform).get('reason') ?? '').trim();
      const ids = [...picked].sort();
      if (!reason) { err.hidden = false; err.textContent = '請寫一下為什麼要改。'; return; }

      const q = new URLSearchParams({ template: 'batch-edit.yml', title: `批次修改：${whatText()}（${ids.length} 場）`, event_ids: ids.join('\n') });
      if (seriesSel.value) q.set('series', seriesSel.value);
      if (jothonSel.value) q.set('jothon', jothonSel.value);
      if (takedown()) q.set('takedown', '請拿掉');
      q.set('reason', reason);
      const url = `${bar.dataset.repo}/issues/new?${q}`;
      if (url.length > MAX_URL || ids.length > MAX_IDS) {
        const idsLen = new URLSearchParams({ x: ids.join('\n') }).toString().length - 2;
        const fit = Math.min(MAX_IDS, Math.floor((MAX_URL - (url.length - idsLen)) / (idsLen / ids.length)));
        err.hidden = false;
        err.textContent = `一次選太多了（${ids.length} 場），請分批送，一批 ${fit} 場以內。`;
        return;
      }
      window.open(url, '_blank', 'noopener');
      dialog.close();
      flash('已在新分頁開好 GitHub issue，按 Submit 才算送出');
    });
    sync();
  }

</script>

